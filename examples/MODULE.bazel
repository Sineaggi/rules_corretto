module(name = "rules_corretto_examples")

bazel_dep(name = "rules_corretto", version = "0.0.0")
local_path_override(
    module_name = "rules_corretto",
    path = "..",
)

bazel_dep(name = "rules_java", version = "9.6.1")

# Root-registered toolchains outrank rules_java's, so this compilation
# toolchain (JavaBuilder/turbine on Corretto) wins for --java_language_version=21.
register_toolchains("//:corretto_toolchain_definition")
